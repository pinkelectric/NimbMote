{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nimbmote",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["dist/server/**/*.js", "dist/server/**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client"
  },
  "observability": {
    "enabled": true
  }
}
